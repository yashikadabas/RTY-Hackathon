# --- Required for live generation (leave blank to run in DEMO MODE) ---
# LLM: set ONE of these. Gemini has a free tier (aistudio.google.com → Get API key).
GEMINI_API_KEY=
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
FAL_KEY=

# --- Optional ---
# Interactive Street View panorama (Maps JavaScript API, referrer-restricted)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Model overrides ---
OPENAI_MODEL=gpt-4o
# Optional: pin a Gemini model; otherwise the newest "gemini-X-flash" is auto-picked
GEMINI_MODEL=
FAL_IMAGE_MODEL=fal-ai/nano-banana-pro/edit
FAL_T2I_MODEL=fal-ai/flux-2/turbo
FAL_VIDEO_MODEL=fal-ai/kling-video/v3/pro/image-to-video
FAL_FACE_RESTORE_MODEL=fal-ai/codeformer
FAL_IMAGE_RESOLUTION=2K
FAL_FACE_RESTORE=1
FILM_GRADE=1

# Force demo mode even when keys are present (1 = on)
DEMO_MODE=0
